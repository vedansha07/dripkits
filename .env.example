# Local dev. Postgres runs in the dripkits-pg Docker container on host port 54329.
DATABASE_URL=postgres://dripkits:dripkits@127.0.0.1:54329/dripkits

# Supabase (cloud project, Phase 1+). Leave blank until the project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test keys (Phase 2). Test mode needs no KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend (Phase 2)
RESEND_API_KEY=
